let instance: Wcall | undefined;
let logFn: WcallLogHandler;

const logHandler: WcallLogHandler = (level, msg, err) => {
  if (logFn)
    logFn(level, msg, err);
  else {
    if (err)
      console.log(msg, err);
    else
      console.log(msg);
  }
}

